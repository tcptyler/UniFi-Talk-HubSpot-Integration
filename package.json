  "private": true,
  "description": "Self-hosted bridge that logs UniFi Talk calls and texts into HubSpot and keeps contacts in sync. No AI, no cloud hosting.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "unifi-talk-hubspot": "src/cli.ts"
  },
  "main": "src/cli.ts",
  "files": [
    "src",
    "rules",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "start": "node src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "chrono-node": "2.10.3",
    "libphonenumber-js": "1.13.15",
    "pino": "10.4.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "selfsigned": "5.5.0",
    "typescript": "7.0.2"
  }
}
