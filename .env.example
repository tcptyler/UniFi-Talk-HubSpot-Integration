# Copy to .env and fill in. Never commit .env.
# Any secret can instead be read from a file: set NAME_FILE=/path/to/file (for Docker secrets).

# ---- UniFi console running Talk
# Address of the console on your network (IP or hostname).
TALK_HOST=192.168.1.1
# TALK_PORT=443

# SHA-256 fingerprint of the console's certificate. Get it with:
#   npm start -- fingerprint 192.168.1.1
TALK_CERT_SHA256=

# Sign-in: set ONE of these. See "Signing in to the console" in the README.
# 1. Console API key
TALK_API_KEY=
# 2. Local console account with Talk access (not possible on consoles in a UniFi Fabric)
# TALK_USERNAME=
# TALK_PASSWORD=
# 3. Browser session token (testing only; it expires)
# TALK_SESSION_TOKEN=

# How often to check the call log, in seconds (minimum 15).
# TALK_POLL_SECONDS=60

# ---- HubSpot
# Service Key (Development > Keys in HubSpot). Not needed for dry runs.
# HUBSPOT_TOKEN=

# ---- Behaviour
# true: only show what would be written to HubSpot. Set to false to write.
DRY_RUN=true
# Put Talk's own call summary in the HubSpot call notes.
# TALK_SUMMARY=true
# Where the local database lives.
# DATA_DIR=./data
# fatal, error, warn, info, debug or trace
# LOG_LEVEL=info
