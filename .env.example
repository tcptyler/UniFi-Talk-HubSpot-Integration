# Copy to .env and fill in. Never commit .env.
# Any secret can instead be read from a file: set NAME_FILE=/path/to/file (for Docker secrets).

# ---- UniFi console running Talk
# Address of the console on your network (IP or hostname).
TALK_HOST=192.168.1.1
# TALK_PORT=443

# SHA-256 fingerprint of the console's certificate. Get it with:
#   npm start -- fingerprint 192.168.1.1
TALK_CERT_SHA256=

# Sign-in: set ONE of these. See "Signing in to the console" in the README.
# 1. Console API key
TALK_API_KEY=
# 2. Local console account with Talk access (not possible on consoles in a UniFi Fabric)
# TALK_USERNAME=
# TALK_PASSWORD=
# 3. Browser session token (testing only; it expires)
# TALK_SESSION_TOKEN=

# How often to check the call log, in seconds (minimum 15).
# TALK_POLL_SECONDS=60
# Talk's web page, linked from HubSpot so reps can play recordings.
# Use your remote address (for example through unifi.ui.com) if reps work off-site.
# TALK_URL=https://192.168.1.1/talk/

# ---- HubSpot
# Service Key (Development > Keys in HubSpot). Not needed for dry runs.
# HUBSPOT_TOKEN=
# GUID of a custom "Meeting booked" call outcome (HubSpot Pro and up).
# HUBSPOT_MEETING_BOOKED_OUTCOME_ID=

# ---- About you
# Your company names, comma separated, so your own introductions on calls are recognised.
# COMPANY_NAMES=Example Company, Example Co
# Your time zone, for reading "Tuesday at 3 pm" said on calls.
# TIME_ZONE=America/Chicago
# Country for numbers said without a country code (defaults to the console's country).
# DEFAULT_COUNTRY=US
# Your own copy of rules/default.yaml.
# RULES_FILE=./my-rules.yaml

# ---- Behaviour
# true: only show what would be written to HubSpot. Set to false to write.
DRY_RUN=true
# Put Talk's own call summary in the HubSpot call notes.
# TALK_SUMMARY=true
# Where the local database lives.
# DATA_DIR=./data
# fatal, error, warn, info, debug or trace
# LOG_LEVEL=info
